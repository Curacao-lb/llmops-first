# Copy to docker/.env. Use URL-safe alphanumeric passwords because the
# PostgreSQL password is embedded in SQLALCHEMY_DATABASE_URI by Compose.
# Example: openssl rand -hex 32
REDIS_PASSWORD=replace-with-a-long-random-value
POSTGRES_PASSWORD=replace-with-a-long-random-value

# Required by the API for signing authentication tokens.
JWT_SECRET_KEY=replace-with-a-different-long-random-value

# Optional integrations. Leave blank when unused.
ASSISTANT_AGENT_ID=6774fcef-b594-8008-b30c-a05b8190afe6
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5173/auth/authorize/github
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
qianfan_ak=
qianfan_sk=
MOONSHOT_API_KEY=
MOONSHOT_API_BASE_URL=
DASHSCOPE_API_KEY=
AMAP_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
OLLAMA_URL=
FUNCTION_CALL_URL=
# Must match the passphrase for the encrypted private.pem in the project root.
PRIVATE_KEY_PASSWORD=

# Optional LangSmith tracing.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=

# Local demo: Mailpit captures emails at http://localhost:8025; it does not
# deliver messages to real inboxes. Use a real SMTP provider for deployment.
SMTP_SERVER=mailpit
SMTP_PORT=1025
SENDER_EMAIL=demo@example.test
SMTP_USERNAME=demo
SMTP_PASSWORD=demo
SMTP_AUTH_METHOD=password
SMTP_CLIENT_ID=
SMTP_REFRESH_TOKEN=
SMTP_TENANT=consumers
SMTP_USE_SSL=false
SMTP_USE_TLS=false
# Optional object-storage settings.
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=
COS_SCHEMA=https
COS_BUCKET=
COS_DOMAIN=
